  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "22.19.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@devvy-ui/core": "workspace:^",
    "@devvy-ui/styles": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/Jttacalig/devvy-ui.git",
    "directory": "packages/react",
    "type": "git"
  },
  "homepage": "https://www.dev-station.dev/ui",
  "bugs": {
    "url": "https://github.com/Jttacalig/devvy-ui/issues"
  }
