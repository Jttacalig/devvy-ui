{
  "name": "@devvy-ui/styles",
  "version": "0.3.0",
  "description": "Ordinary CSS for DEVVY UI",
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./components.css"
    },
    "./components.css": {
      "types": "./index.d.ts",
      "default": "./components.css"
    },
    "./fonts.css": {
      "types": "./fonts.d.ts",
      "default": "./fonts.css"
    },
    "./fonts/geist.css": {
      "types": "./fonts.d.ts",
      "default": "./fonts/geist.css"
    },
    "./fonts/manrope.css": {
      "types": "./fonts.d.ts",
      "default": "./fonts/manrope.css"
    },
    "./fonts/geist-mono.css": {
      "types": "./fonts.d.ts",
      "default": "./fonts/geist-mono.css"
    },
    "./glass.css": {
      "types": "./glass.d.ts",
      "default": "./glass.css"
    }
  },
  "files": [
    "components.css",
    "LICENSE",
    "README.md",
    "glass.css",
    "index.d.ts",
    "glass.d.ts",
    "fonts.css",
    "fonts.d.ts",
    "fonts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@devvy-ui/tokens": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/Jttacalig/devvy-ui.git",
    "directory": "packages/styles",
    "type": "git"
  },
  "homepage": "https://devvy-ui.dev-station.dev/ui",
  "bugs": {
    "url": "https://github.com/Jttacalig/devvy-ui/issues"
  }
}
