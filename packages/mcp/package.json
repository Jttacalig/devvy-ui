{
  "name": "devvy-ui-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Optional local MCP developer tools for DEVVY UI",
  "bin": {
    "devvy-ui-mcp": "./dist/server.mjs"
  },
  "files": [
    "dist/server.mjs",
    "dist/snapshot.json",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Jttacalig/devvy-ui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://devvy-ui.dev-station.dev/ui/mcp",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:inspector": "node --test test/inspector.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "prepack": "node scripts/check-artifact.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devvy-ui/published-registry": "npm:@devvy-ui/registry@0.3.1",
    "@devvy-ui/registry": "workspace:^",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
