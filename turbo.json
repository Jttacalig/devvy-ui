{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "@devvy-ui/registry#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/react/src/components/**",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/styles/*.css",
        "$TURBO_ROOT$/packages/tokens/src/theme.css",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": ["dist/**", "LICENSE"]
    },
    "devvy-ui-docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/vite-react/src/**",
        "$TURBO_ROOT$/packages/react/src/components/**",
        "$TURBO_ROOT$/packages/tokens/src/theme.css",
        "$TURBO_ROOT$/packages/styles/*.css",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
